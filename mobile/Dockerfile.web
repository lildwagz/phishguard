# Serves the prebuilt Flutter web app and the Android APK. Build both in mobile/ first:
#   flutter build web --release
#   flutter build apk --release --dart-define=API_BASE_URL=https://phishguard.taile0ea7c.ts.net
# and proxies /v1/ + /health to the api container (same origin; see mobile/nginx.conf).
FROM nginx:1.27-alpine
COPY mobile/nginx.conf /etc/nginx/conf.d/default.conf
COPY mobile/build/web /usr/share/nginx/html
COPY mobile/build/app/outputs/flutter-apk/app-release.apk /usr/share/nginx/html/download/PhishGuard.apk
